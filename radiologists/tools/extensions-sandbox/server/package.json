{
  "name": "extensions-sandbox-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync-schemas": "tsx scripts/sync-cli-schemas.ts",
    "generate-schemas": "tsx scripts/generate-output-schemas.ts",
    "dev": "npm run sync-schemas && tsx watch --conditions=development src/index.ts",
    "build": "npm run sync-schemas && npm run generate-schemas && tsc -p tsconfig.json && cpy \"src/schemas/**/*.json\" dist/schemas",
    "start": "node dist/index.js",
    "test": "npm run sync-schemas && npm run generate-schemas && vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "extensions-sandbox-shared": "*",
    "js-yaml": "^4.3.0",
    "multer": "^2.2.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.15.0",
    "cpy-cli": "^7.0.0",
    "rimraf": "^6.1.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.7"
  }
}
